<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Campo para ID de la Cuenta -->
        <EditText
            android:id="@+id/etCuentaId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID de la Cuenta"
            android:inputType="number" />

        <!-- Campo para ID de la Categoría -->
        <EditText
            android:id="@+id/etCategoriaId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="ID de la Categoría"
            android:inputType="number" />

        <!-- Campo para el Monto -->
        <EditText
            android:id="@+id/etMonto"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Monto"
            android:inputType="numberDecimal" />

        <!-- Spinner para Tipo (ingreso/gasto) -->
        <Spinner
            android:id="@+id/spTipo"
            android:layout_width="match_parent"
            android:layout_height="wrap_content" />

        <!-- Campo para Fecha de Transacción -->
        <EditText
            android:id="@+id/etFechaTransaccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Fecha (YYYY-MM-DD HH:MM:SS)"
            android:inputType="datetime" />

        <!-- Campo para Descripción -->
        <EditText
            android:id="@+id/etDescripcion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Descripción"
            android:inputType="textMultiLine" />

        <!-- Botón para Guardar Transacción -->
        <Button
            android:id="@+id/btnGuardarTransaccion"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Guardar Transacción"
            android:layout_marginTop="20dp" />
    </LinearLayout>
</ScrollView>
